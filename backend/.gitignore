# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

dist

# The sheets/ folder is ignored, but the Apps Scripts inside it are source and
# belong in the repo — the other two CRMs already track theirs. Anything else
# dropped in here (exports, dumps) stays ignored.
# Note: sheets/* not sheets/ — git will not descend into an excluded
# directory, so the negation below is only reachable if the contents are
# excluded rather than the directory itself.
sheets/*
!sheets/*.gs

# Telegram backup temp files
backups/
